# Copy to staging/web.env.local; then to .env.staging.local before preflight.
# All supplied Firebase web values must come from the isolated Club staging web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_USE_FIREBASE_EMULATORS=false
VITE_APP_MODE=
VITE_DEV_CLUB_ID=
VITE_CAPACITOR_CLUB_ID=
VITE_CAPACITOR_CLUB_DOMAIN=
VITE_FUNCTIONS_URL=
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MLM=false
VITE_INTEGRATION_SSO_ENABLED=false
