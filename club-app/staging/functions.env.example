# Copy to staging/functions.env.local. No secret values belong in this file.
# After approval, install as functions/.env.<actual Club staging project ID>.
INTEGRATION_HANDOFF_ENABLED=false
CLUB_INTEGRATION_AUDIENCE=urn:club-growline:staging
GROWLINE_PROJECT_ID=
# Provision these separately in the Club staging project's Secret Manager:
# CLUB_GROWLINE_SERVICE_KEYS
# CLUB_LINK_CODE_PEPPER

INTEGRATION_ACTIVITY_ENABLED=false
INTEGRATION_SSO_ENABLED=false
GROWLINE_ACTIVITY_URL=
GROWLINE_INTEGRATION_AUDIENCE=urn:growline-club:staging:activity
CLUB_GROWLINE_SERVICE_KEY_ID=
# SSO stays off. Supply reviewed origins/key ID only for a separately approved SSO staging gate.
FEDERATION_SERVICE_KEY_ID=
FEDERATION_CLUB_ORIGIN=
FEDERATION_GROWLINE_ORIGIN=
FEDERATION_PEER_URL=
STAGING_SSO_APPROVAL_REFERENCE=
# Dedicated Secret Manager binding: FEDERATION_SERVICE_KEY (never reuse handoff/activity credentials).
