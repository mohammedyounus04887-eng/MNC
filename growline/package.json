{
  "name": "growline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project growline-dev",
    "db:seed": "tsx scripts/seed-sqlite.ts",
    "migrate:firestore": "tsx scripts/migrate-to-firestore.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts",
    "verify:reparent": "tsx scripts/verify-reparent.ts",
    "test:unit": "node --import tsx --test \"tests/**/*.test.ts\"",
    "e2e": "playwright test",
    "e2e:reset": "npm run db:seed && tsx scripts/reset-emulators.ts && npm run migrate:firestore",
    "test:rules": "tsx e2e/rules.test.ts",
    "test:rules:boards": "tsx e2e/leaderboards-rules.test.ts",
    "test:rules:quals": "tsx e2e/qualifications-rules.test.ts",
    "test:rules:duplication": "tsx e2e/duplication-rules.test.ts",
    "test:rules:session4": "tsx e2e/session4-rules.test.ts",
    "test:rules:workspaces": "tsx e2e/workspace-rules.test.ts",
    "backfill:workspaces": "tsx scripts/backfill-workspaces.ts",
    "verify:workspaces": "tsx scripts/verify-workspaces.ts",
    "test:rules:goals": "tsx e2e/goals-rules.test.ts",
    "test:rules:wall": "tsx e2e/wall-rules.test.ts",
    "verify:indexes": "tsx scripts/verify-indexes.ts",
    "verify:rules": "tsx scripts/verify-production-rules.ts",
    "verify:build": "tsx scripts/verify-cloud-build.ts",
    "backfill:prospect-activity": "tsx scripts/backfill-prospect-activity.ts",
    "test:unit:native": "node --import ./scripts/test-typescript.mjs --test \"tests/**/*.test.ts\"",
    "test:readiness": "node --import ./scripts/test-typescript.mjs --test --test-concurrency=1 tests/owner-activity.test.mjs tests/job-readiness.test.mjs tests/federation-readiness.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.26.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
